            assert output.contains(
                'All samples were dropped; see dropped_samples.txt'
            )
            def dropped = new File("${outputDir}/dropped_samples.txt")
            assert dropped.isFile()
            assert dropped.readLines().findAll { it.trim() } ==
                ['sample_empty']
        }
    }

    test("test_missing_index_prefix_fails_early") {
        setup {
            ChoCallateTestUtils.samplesheet(
                new File(launchDir),
                [
                    [
                        'sample1',
                        "${projectDir}/test_run/test_reads_R1.fq.gz",
                        "${projectDir}/test_run/test_reads_R2.fq.gz"
                    ]
                ]
            )
        }

        when {
            params {
                input {
                    samples_tsv = "${launchDir}/samples.tsv"
                    reference_genome = "${projectDir}/test_run/" +
                        "arth_chr1.fasta.gz"
                    reference_index_dir = "${launchDir}"
                    reference_index_prefix = "missing_index_prefix"
                    format = "fastq"
                    reads_type = "pe"
                }
                output {
                    directory = "${outputDir}"
                    type = "single"
                    format = "bcf"
                    remove_invariant = true
                }
                calling {
                    callers = "bcftools"
                }
                consensus {
                    threshold = 1
                }
            }
        }

        then {
            assert workflow.failed
            assert workflow.trace.tasks().isEmpty()
            def output = ([workflow.errorMessage ?: ''] +
                          workflow.stdout + workflow.stderr).join('\n')
            assert output.contains("No bowtie2 index files found")
            assert output.contains("missing_index_prefix")
        }
    }
}
