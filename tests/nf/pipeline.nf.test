    test("test_se_bwa_sample_vcf") {
        setup {
            ChoCallateTestUtils.bwaIndex(
                projectDir, new File(launchDir)
            )
            ChoCallateTestUtils.samplesheet(
                new File(launchDir),
                [
                    [
                        'sample_se',
                        "${projectDir}/test_run/test_reads_R1.fq.gz"
                    ]
                ]
            )
        }

        when {
            params {
                input {
                    samples_tsv = "${launchDir}/samples.tsv"
                    reference_genome = "${launchDir}/reference/" +
                        "genome.fasta"
                    reference_index_dir = "${launchDir}/reference"
                    reference_index_prefix = "genome.fasta"
                    format = "fastq"
                    reads_type = "se"
                }
                output {
                    directory = "${outputDir}"
                    type = "sample"
                    format = "vcf"
                    remove_invariant = true
                }
                mapping {
                    mapper = "bwa"
                }
                coverage {
                    min_coverage = 1
                }
                calling {
                    callers = "bcftools"
                }
                consensus {
                    threshold = 1
                }
            }
        }

        then {
            assert workflow.success
            def vcf = new File(
                "${outputDir}/per_sample/sample_se.vcf.gz"
            )
            assert vcf.isFile()
            assert vcf.length() > 0
            assert ChoCallateTestUtils.vcfSamples(vcf) == ['sample_se']
            def header = ChoCallateTestUtils.vcfHeader(vcf)
            assert header.contains('##ChoCallate=<')
            assert header.contains('##ChoCallateCommand=')
            assert header.contains(
                '##contig=<ID=CP002684.1,length=200001>'
            )
            assert ChoCallateTestUtils.recordCount(vcf) == 307
            assert snapshot(
                ChoCallateTestUtils.statsLines(vcf)
            ).match()
        }
    }

