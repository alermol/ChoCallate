nextflow_pipeline {

    name "ChoCallate pipeline"
    script "main.nf"

    test("PE bowtie2, single bcftools caller, merged output") {
        setup {
            def reference = new File(
                projectDir, 'test_run/arth_chr1.fasta.gz')
            def indexDir = new File(launchDir, 'index')
            indexDir.mkdirs()
            def indexPrefix = new File(indexDir, reference.name)
            def build = [
                'bowtie2-build', '--quiet', '--threads', '2',
                reference.absolutePath, indexPrefix.absolutePath
            ].execute()
            build.waitFor()
            assert build.exitValue() == 0

            def samples = new File(launchDir, 'samples.tsv')
            samples.text = "sample1\t${reference.parent}/" +
                "test_reads_R1.fq.gz\t${reference.parent}/" +
                "test_reads_R2.fq.gz\n"
        }

        when {
            params {
                input {
                    samples_tsv = "${launchDir}/samples.tsv"
                    reference_genome = "${projectDir}/" +
                        "test_run/arth_chr1.fasta.gz"
                    reference_index_dir = "${launchDir}/index"
                    reference_index_prefix = "arth_chr1.fasta.gz"
                }
                output {
                    directory = "${outputDir}"
                    remove_invariant = false
                }
                coverage {
                    min_coverage = 1
                }
                mapping {
                    cpu = 2
                }
                calling {
                    callers = "bcftools"
                    cpu = 2
                }
                consensus {
                    threshold = 1
                    cpu = 2
                }
                resources {
                    low {
                        cpus = 1
                        memory_mb = 2048
                    }
                    medium {
                        cpus = 2
                        memory_mb = 4096
                    }
                    high {
                        cpus = 2
                        memory_mb = 4096
                    }
                }
            }
        }

        then {
            assert workflow.success
            def consensus = new File("${outputDir}/consensus.bcf")
            assert consensus.isFile()
            assert consensus.length() > 100000

            def headerFile = new File(launchDir, 'consensus.header.txt')
            def header = new ProcessBuilder(
                'bash', '-c',
                "bcftools view -h '${consensus}' > '${headerFile}'"
            ).start()
            assert header.waitFor() == 0
            assert headerFile.text.contains('##ChoCallate=<')
            assert headerFile.text.contains('##ChoCallateCommand=')
            assert headerFile.text.contains('##contig=<ID=CP002684.1')

            def countFile = new File(launchDir, 'consensus.count.txt')
            def count = new ProcessBuilder(
                'bash', '-c',
                "bcftools view -H '${consensus}' | wc -l > '${countFile}'"
            ).start()
            assert count.waitFor() == 0
            assert countFile.text.trim() as int > 1000
        }
    }
}
