nextflow_pipeline {

    name "ChoCallate pipeline modes"
    script "main.nf"

    test("test_pe_bowtie2_single") {
        setup {
            ChoCallateTestUtils.bowtie2Index(
                projectDir, new File(launchDir)
            )
            ChoCallateTestUtils.samplesheet(
                new File(launchDir),
                [
                    [
                        'sample1',
                        "${projectDir}/test_run/test_reads_R1.fq.gz",
                        "${projectDir}/test_run/test_reads_R2.fq.gz"
                    ]
                ]
            )
        }

        when {
            params {
                input {
                    samples_tsv = "${launchDir}/samples.tsv"
                    reference_genome = "${launchDir}/reference/" +
                        "genome.fasta"
                    reference_index_dir = "${launchDir}/reference"
                    reference_index_prefix = "genome.fasta"
                    format = "fastq"
                    reads_type = "pe"
                }
                output {
                    directory = "${outputDir}"
                    type = "single"
                    format = "bcf"
                    remove_invariant = true
                }
                coverage {
                    min_coverage = 1
                }
                calling {
                    callers = "bcftools"
                }
                consensus {
                    threshold = 1
                }
            }
        }

        then {
            assert workflow.success
            def consensus = new File("${outputDir}/consensus.bcf")
            assert consensus.isFile()
            assert consensus.length() > 0
            assert ChoCallateTestUtils.vcfSamples(consensus) ==
                ['sample1']
            def header = ChoCallateTestUtils.vcfHeader(consensus)
            assert header.contains('##ChoCallate=<')
            assert header.contains('##ChoCallateCommand=')
            assert header.contains(
                '##contig=<ID=CP002684.1,length=200001>'
            )
            assert ChoCallateTestUtils.recordCount(consensus) == 271
            assert snapshot(
                ChoCallateTestUtils.statsLines(consensus)
            ).match()
        }
    }

