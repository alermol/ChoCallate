nextflow_process {

    name "Test process ANNOTATE_HEADER"
    script "../../../../modules/local/annotate_header/main.nf"
    process "ANNOTATE_HEADER"

    test("attaches the command line header to a sample BCF") {
        setup {
            def bcfs = new File(launchDir, 'bcfs')
            ChoCallateTestUtils.writeBcf(
                bcfs, 'sample_a', 'sample_a',
                [
                    ['CP002684.1', '10', '.', 'G', 'A', '50', 'PASS', '.',
                     'GT:AD:DP', '0/1:5,5:10'],
                    ['CP002684.1', '20', '.', 'T', 'C', '50', 'PASS', '.',
                     'GT:AD:DP', '1/1:0,10:10']
                ]
            )
        }

        when {
            process {
                """
                input[0] = tuple(
                    'sample_a',
                    file("${launchDir}/bcfs/sample_a.bcf")
                )
                """
            }
        }

        then {
            assert process.success
            def bcf = ChoCallateTestUtils.outputFile(
                process.out.consensus_bcf[0][1]
            )
            assert bcf.isFile()
            assert ChoCallateTestUtils.vcfSamples(bcf) == ['sample_a']
            def header = ChoCallateTestUtils.vcfHeader(bcf)
            assert header.contains('##ChoCallate=<Version=test')
            assert header.contains('##ChoCallateCommand=')
            assert ChoCallateTestUtils.recordCount(bcf) == 2
        }
    }
}
