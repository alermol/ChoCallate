nextflow_process {

    name "Test process PREPARE_BAM"
    script "../../../../modules/local/prepare_bam/main.nf"
    process "PREPARE_BAM"

    test("replaces read groups and indexes an input BAM") {
        setup {
            ChoCallateTestUtils.bowtie2Bam(
                projectDir, new File(launchDir), 'bam_sample'
            )
        }

        when {
            process {
                """
                input[0] = tuple(
                    'bam_sample',
                    file("${launchDir}/bam_sample.bam"),
                    file("${projectDir}/assets/NO_FILE"),
                    file("${projectDir}/assets/NO_FILE")
                )
                input[1] = file("${launchDir}/reference/genome.fasta")
                input[2] = file("${launchDir}/reference/genome.dict")
                input[3] = file("${launchDir}/reference/genome.fasta.fai")
                """
            }
        }

        then {
            assert process.success
            def bam = ChoCallateTestUtils.outputFile(
                process.out.bam[0][1]
            )
            def csi = ChoCallateTestUtils.outputFile(
                process.out.bam[0][2]
            )
            def raw = ChoCallateTestUtils.outputFile(
                process.out.bam[0][3]
            )
            assert bam.isFile()
            assert csi.isFile()
            assert raw.isFile()
            assert raw.readLines().any { it.contains('mapped') }
            assert ChoCallateTestUtils.bamRecords(bam) > 0
            def header = ChoCallateTestUtils.bamHeader(bam)
            assert header.contains('ID:bam_sample')
            assert header.contains('SM:bam_sample')
            assert header.contains('PL:ILLUMINA')
            assert header.contains('LB:bam_sample')
            def rg = header.readLines().find { it.startsWith('@RG') }
            assert snapshot(
                [ChoCallateTestUtils.bamRecords(bam), rg]
            ).match()
        }
    }
}
