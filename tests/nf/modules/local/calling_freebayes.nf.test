nextflow_process {

    name "Test process CALLING_FREEBAYES"
    script "../../../../modules/local/calling_freebayes/main.nf"
    process "CALLING_FREEBAYES"

    test("calls variants from a BAM") {
        setup {
            ChoCallateTestUtils.bowtie2Bam(
                projectDir, new File(launchDir), 'sample1'
            )
            def chunks = new File(launchDir, 'chunks')
            chunks.mkdirs()
            new File(chunks, 'full.bed').text =
                "CP002684.1\t0\t200001\n"
        }

        when {
            process {
                """
                input[0] = tuple(
                    'sample1',
                    file("${launchDir}/sample1.bam"),
                    file("${launchDir}/sample1.bam.csi"),
                    file("${launchDir}/chunks/full.bed")
                )
                input[1] = file("${launchDir}/reference/genome.fasta")
                input[2] = file("${launchDir}/reference/genome.fasta.fai")
                input[3] = file("${launchDir}/reference/genome.dict")
                """
            }
        }

        then {
            assert process.success
            def bcf = ChoCallateTestUtils.outputFile(
                process.out.calling_result[0][1]
            )
            assert bcf.isFile()
            assert ChoCallateTestUtils.vcfSamples(bcf) == ['sample1']
            def header = ChoCallateTestUtils.vcfHeader(bcf)
            assert header.contains(
                '##contig=<ID=CP002684.1,length=200001>'
            )
            assert ChoCallateTestUtils.recordCount(bcf) == 296
            assert snapshot(
                ChoCallateTestUtils.statsLines(bcf)
            ).match()
        }
    }
}
