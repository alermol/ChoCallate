nextflow_process {

    name "Test process CALLING_GATK"
    script "../../../../modules/local/calling_gatk/main.nf"
    process "CALLING_GATK"

    test("calls variants from a BAM") {
        setup {
            ChoCallateTestUtils.bowtie2Bam(
                projectDir, new File(launchDir), 'sample1'
            )
            def chunks = new File(launchDir, 'chunks')
            chunks.mkdirs()
            new File(chunks, 'full.bed').text =
                "CP002684.1\t0\t200001\n"
        }

        when {
            process {
                """
                input[0] = tuple(
                    'sample1',
                    file("${launchDir}/sample1.bam"),
                    file("${launchDir}/sample1.bam.csi"),
                    file("${launchDir}/chunks/full.bed")
                )
                input[1] = file("${launchDir}/reference/genome.fasta")
                input[2] = file("${launchDir}/reference/genome.fasta.fai")
                input[3] = file("${launchDir}/reference/genome.dict")
                """
            }
        }

        then {
            assert process.success
            def bcf = ChoCallateTestUtils.outputFile(
                process.out.calling_result[0][1]
            )
            assert bcf.isFile()
            assert ChoCallateTestUtils.vcfSamples(bcf) == ['sample1']
            def header = ChoCallateTestUtils.vcfHeader(bcf)
            assert header.contains(
                '##contig=<ID=CP002684.1,length=200001>'
            )
            assert ChoCallateTestUtils.recordCount(bcf) == 687
            assert snapshot(
                ChoCallateTestUtils.statsLines(bcf)
            ).match()
        }
    }

    test("drops calls from the interval padding of adjacent chunks") {
        setup {
            ChoCallateTestUtils.bowtie2Bam(
                projectDir, new File(launchDir), 'sample1'
            )
            def chunks = new File(launchDir, 'chunks')
            chunks.mkdirs()
            new File(chunks, 'left.bed').text =
                "CP002684.1\t99500\t100000\n"
            new File(chunks, 'right.bed').text =
                "CP002684.1\t100000\t100500\n"
        }

        when {
            process {
                """
                input[0] = tuple(
                    'sample1',
                    file("${launchDir}/sample1.bam"),
                    file("${launchDir}/sample1.bam.csi"),
                    [
                        file("${launchDir}/chunks/left.bed"),
                        file("${launchDir}/chunks/right.bed")
                    ]
                )
                input[1] = file("${launchDir}/reference/genome.fasta")
                input[2] = file("${launchDir}/reference/genome.fasta.fai")
                input[3] = file("${launchDir}/reference/genome.dict")
                """
            }
        }

        then {
            assert process.success
            def bcf = ChoCallateTestUtils.outputFile(
                process.out.calling_result[0][1]
            )
            def records = ChoCallateTestUtils.vcfRecords(bcf)
            def positions = records.collect { line ->
                line.split('\t')[1] as int
            }
            // POS 100030 is outside the left unpadded chunk (which ends at
            // 100000) but inside its padding, so both chunks call it.
            assert positions.count { pos -> pos == 100030 } == 1
            // Calls outside the unpadded chunks come only from padding:
            // left starts at 99500 and right ends at 100500 (0-based BED).
            assert positions.every { pos -> pos >= 99501 }
            assert positions.every { pos -> pos <= 100500 }
        }
    }
}
