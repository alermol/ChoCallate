// Additional Nextflow configuration for the nf-test runs.

// Work directories must survive until assertions run, so disable the
// nf-boost cleanup observer in tests. This sets the boost scope directly:
// `boost.cleanup` is evaluated in nextflow.config before this file is loaded,
// so a params override here would not reach it.
boost {
    cleanup = false
}

params {
    resources {
        max_retries = 0
        low {
            cpus = 1
            memory_mb = 2048
        }
        medium {
            cpus = 2
            memory_mb = 4096
        }
        high {
            cpus = 2
            memory_mb = 4096
        }
    }

    mapping {
        cpu = 2
    }

    calling {
        cpu = 2
    }

    consensus {
        cpu = 2
    }
}
