/*
 * Resource labels shared by all pipeline processes.  The limits live in the
 * params map so they can be overridden with -params-file like every other
 * pipeline option.
 */
process {
    maxRetries = params.resources.max_retries

    // Transient resource failures are retried with the escalated memory of
    // the next attempt.  Any other error terminates the task.
    errorStrategy = {
        task.exitStatus in [137, 140] &&
        task.attempt <= params.resources.max_retries
            ? 'retry'
            : 'terminate'
    }

    withLabel: process_low {
        cpus = params.resources.low.cpus
        memory = { params.resources.low.memory_mb.MB * task.attempt }
        time = params.resources.low.time
    }

    withLabel: process_medium {
        cpus = params.resources.medium.cpus
        memory = { params.resources.medium.memory_mb.MB * task.attempt }
        time = params.resources.medium.time
    }

    withLabel: process_high {
        cpus = params.resources.high.cpus
        memory = { params.resources.high.memory_mb.MB * task.attempt }
        time = params.resources.high.time
    }

    // A label sets the CPU count for processes without a stage-specific
    // option.  These selectors take precedence and keep mapping.cpu,
    // calling.cpu and consensus.cpu authoritative for their stages.
    withName: 'MAPPING_BOWTIE2|MAPPING_BWA|MAPPING_MINIMAP2|PREPARE_BAM' {
        cpus = params.mapping?.cpu ?: params.resources.medium.cpus
    }

    withName: 'CALLING_BCFTOOLS|CALLING_FREEBAYES|CALLING_GATK' {
        cpus = params.calling?.cpu ?: params.resources.medium.cpus
        errorStrategy = {
            task.exitStatus in [137, 140] &&
            task.attempt <= params.resources.max_retries
                ? 'retry'
                : (params.calling?.allow_caller_failure
                    ? 'ignore'
                    : (task.attempt <= params.resources.max_retries
                        ? 'retry'
                        : 'terminate'))
        }
    }

    withName: 'SCATTER_INTERVALS' {
        cpus = params.calling?.cpu ?: params.resources.medium.cpus
    }

    withName: 'GENERATE_CONSENSUS|MERGE_OUTPUTS' {
        cpus = params.consensus?.cpu ?: params.resources.medium.cpus
    }
}
