// ChoCallate Nextflow Configuration File

// Input/Output parameters
params {
    samples_tsv        = 'input.tsv'
    outdir             = 'ChoCallate_output'

    // Samplesheet processing parameters
    chunk_size         = 0

    // Quality thresholds
    min_coverage       = 5
    min_base_quality   = 20
    min_map_qual       = 10
    min_snp_qual       = 20

    // Ploidy settings
    ploidy             = 2

    // Data type parameters
    reads_type         = 'pe'  // se - single-end reads; pe - pair-end reads, mx - se and pe reads
    reads_source       = 'gbs' // gbs - Genotyping-by-sequencing; wgs - Whole Genome Sequencing

    effective_callers  = ''

    // CPU and resource allocation
    bowtie2_cpu        = 10
    bcftools_cpu       = 1
    vardict_cpu        = 1
    zero_vcf_cpu       = 1
    cons_cpus          = 5

    // Parallel processing parameters
    bowtie2_forks      = 1
    calling_forks      = 1
    zero_vcf_forks     = 1
    cons_forks         = 1

    // Consensus processing parameters
    win_size           = 1000000
    
    // Consensus parameters
    cons_type          = 'mj' // mj - majority rule, n1 - n-1 consensus (n - number of available callers), fc - full consensus (all callers must identifiy variant)

        // Debug mode
    debug              = false
    
    // Logging parameters
    log_level          = 'INFO'           // DEBUG, INFO, WARN, ERROR, FATAL
    log_format         = 'json'           // json, text, or both
    log_timestamp      = true             // Include timestamps in logs
    log_process        = true             // Include process names in logs
    log_sample         = true             // Include sample IDs in logs
    log_file           = "ChoCallate.log"
    log_error_file     = "ChoCallate_errors.log"
}

// Reporting configuration
report {
    enabled = true
    file = "${params.outdir}/pipeline_report.html"
}

// Timeline configuration
timeline {
    enabled = true
    file = "${params.outdir}/timeline_report.html"
}

// Trace configuration
trace {
    enabled = true
    file = "${params.outdir}/trace.txt"
}

// Manifest configuration
manifest {
    name = 'ChoCallate'
    author = 'A. Ermolaev'
    description = 'Consensus variant calling pipeline'
    version = '1.0.0'
    nextflowVersion = '>=20.0.0'
}
