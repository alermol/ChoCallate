// ChoCallate Nextflow Configuration File

// Input/Output parameters
params {
    samples_tsv                     = 'input.tsv'
    outdir                          = 'ChoCallate_output'

    // Quality thresholds
    min_coverage                    = 5
    min_base_quality                = 5
    min_map_qual                    = 10
    min_snp_qual                    = 5

    // Ploidy settings
    ploidy                          = 2

    // Data type parameters
    input_format                    = 'fastq' // fastq or bam
    reads_type                      = 'pe'   // se - single-end reads; pe - pair-end reads, mx - se and pe reads
    reads_source                    = 'gbs'  // gbs - Genotyping-by-sequencing; wgs - Whole Genome Sequencing

    effective_callers               = '-'    // Use '-' for automatic caller selection based on ploidy, or specify comma-separated list

    // CPU and resource allocation
    bowtie2_cpu                     = 10
    bcftools_cpu                    = 1
    vardict_cpu                     = 1
    zero_bcf_cpu                    = 1
    cons_cpus                       = 5

    // Parallel processing parameters
    bowtie2_forks                   = 1
    calling_forks                   = 1
    zero_bcf_forks                  = 1
    cons_forks                      = 1

    // Consensus processing parameters
    win_size                        = 1000000

    // Consensus parameters
    cons_type                       = 'mj'   // mj - majority rule, n1 - n-1 consensus (n - number of available callers), fc - full consensus (all callers must identifiy variant)

    // Debug mode
    debug                           = false

    // Cleanup configuration parameters
    // Note: Work directory always persists after pipeline completion
    // In production mode: Sample-level cleanup is performed to clean intermediate files
    // In debug mode: All intermediate files are preserved for analysis
    enable_sample_cleanup           = !params.debug      // Enable/disable sample-specific cleanup (false in debug mode)
    cleanup_intermediate_bam        = !params.debug      // Remove intermediate BAM files (false in debug mode)
    cleanup_intermediate_bcf        = !params.debug      // Remove intermediate BCF files (false in debug mode)
    cleanup_intermediate_subfolders = !params.debug      // Remove intermediate subfolders (false in debug mode)
    cleanup_input_symlinks          = !params.debug      // Remove symlinks to input files (false in debug mode)

    // Logging parameters
    log_level                       = 'INFO'            // DEBUG, INFO, WARN, ERROR, FATAL
    log_format                      = 'json'            // json, text, or both
    log_timestamp                   = true              // Include timestamps in logs
    log_process                     = true              // Include process names in logs
    log_sample                      = true              // Include sample IDs in logs
    log_file                        = "ChoCallate.log"
    log_error_file                  = "ChoCallate_errors.log"
}

// Reporting configuration
report {
    enabled     = true
    overwrite   = true
    file        = "${params.outdir}/pipeline_report.html"
}

// Timeline configuration
timeline {
    enabled     = true
    overwrite   = true
    file        = "${params.outdir}/timeline_report.html"
}

// Trace configuration
trace {
    enabled     = true
    overwrite   = true
    file        = "${params.outdir}/trace.txt"
}

// Manifest configuration
manifest {
    name            = 'ChoCallate'
    description     = 'Consensus variant calling pipeline'
    author          = 'A. Ermolaev'
    version         = '1.0.0'
    nextflowVersion = '>=25.0.0'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    homePage        = 'https://github.com/alermol/chocallate'
    license         = 'MIT'
}
