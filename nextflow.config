plugins {
    id 'nf-boost@0.7.0'
    id 'nf-schema@3.0.0'
}

boost {
    cleanup = 'v2'
}

// Schema validation of the nested params map. Unknown keys (typos or options
// removed in 4.0.0) are reported as errors before any process starts.
validation {
    logging {
        unrecognisedParams = 'error'
    }
}

// Defaults for every pipeline option. Values supplied with -params-file are
// deep-merged into these maps, so a run only needs to override what differs
// from the template (assets/templates/config.yaml).
params {
    input {
        samples_tsv = null
        reference_genome = null
        reference_index_dir = null
        reference_index_prefix = null
        include_bed = null
        exclude_bed = null
        format = 'fastq'
        reads_type = 'pe'
    }

    output {
        directory = 'ChoCallate_output'
        type = 'single'
        format = 'bcf'
        remove_invariant = true
        split_multiallelic = false
        compress_reference_blocks = false
        publish_mode = 'copy'
    }

    resources {
        max_retries = 3
        low {
            cpus = 1
            memory_mb = 4096
            time = '4h'
        }
        medium {
            cpus = 6
            memory_mb = 16384
            time = '24h'
        }
        high {
            cpus = 8
            memory_mb = 32768
            time = '48h'
        }
    }

    mapping {
        mapper = 'bowtie2'
        extra_args = ''
        cpu = 10
        platform = 'ILLUMINA'
        library = null
    }

    bam_filter {
        min_map_qual = 10
    }

    rmdup {
        enabled = false
    }

    left_align_indels {
        enabled = true
    }

    coverage {
        min_coverage = 5
    }

    calling {
        callers = 'bcftools,gatk,freebayes'
        cpu = 4
        allow_caller_failure = false
        bcftools {
            min_snp_qual = 20
            min_indel_qual = 20
            call {
                extra_args = ''
            }
            mpileup {
                extra_args = ''
            }
        }
        freebayes {
            min_snp_qual = 20
            min_indel_qual = 20
            extra_args = ''
        }
        gatk {
            min_snp_qual = 20
            min_indel_qual = 20
            interval_padding = 150
            extra_args = ''
        }
    }

    consensus {
        threshold = 2
        cpu = 4
        absent_vote = 'ref'
        filtered_vote = 'abstain'
        tie_policy = 'nocall'
    }
}

// Reporting configuration
report {
    enabled     = true
    overwrite   = true
    file        = "${params.output.directory}/pipeline_report.html"
}

// Timeline configuration
timeline {
    enabled     = true
    overwrite   = true
    file        = "${params.output.directory}/timeline_report.html"
}

// Trace configuration
trace {
    enabled     = true
    overwrite   = true
    file        = "${params.output.directory}/trace.txt"
}

manifest {
    name            = 'ChoCallate'
    version         = '3.2.4'
    nextflowVersion = '>=26.04.6'
    homePage        = 'https://github.com/alermol/ChoCallate'
    mainScript      = 'main.nf'
}

// Process labels depend on the params defined above, so this file is loaded
// after them.
includeConfig 'conf/base.config'
