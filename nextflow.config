// ChoCallate Nextflow Configuration File

nextflow.enable.dsl = 2

plugins {
  id 'nf-boost'
}

boost {
  cleanup = true
}

profiles {
    diploid {
        params {
            ploidy = 2
            callers = 'bcftools,gatk,freebayes,snver,vardict'
        }
    }
    polyploid {
        params {
            ploidy = null
            callers = 'gatk,freebayes,snver'
        }
    }
}

params {
    // Required parameters
    samples_tsv                     = null
    outdir                          = null
    reference_genome                = null
    reference_index                 = null
    cons_threshold                  = null
    custom_bed                      = null
    input_format                    = 'fastq'
    reads_type                      = 'pe'

    // Reference preparation parameters
    reference_preparation {
        decompress {
            bgzip = false // if true, the reference genome will be decompressed using bgzip
            cpu = 1
        }
        fai_index {
            cpu = 1
        }
    }

    // Parameters of BAM file preparation
    bam_preparation {
        mapper = 'bowtie2'
        remove_duplicates = false
        left_align_indels = true
        forks = 1
        mapping {
            bowtie2 {
                cpu = 10
                extra_args = '--no-unal'
            }
            bwa {
                cpu = 10
                extra_args = ''
            }
            minimap2 {
                cpu = 10
                extra_args = ''
            }
        }
        filter {
            cpu = 1
            forks = 1
            min_map_qual = 0
            samtools {
                view {
                    extra_args = '-F 4'
                }
            }
        }
        rm_duplicates {
            cpu = 1
            forks = 1
            extra_args = '--VALIDATION_STRINGENCY SILENT --REMOVE_DUPLICATES true'
        }
        left_align_indels {
            cpu = 1
            forks = 1
            extra_args = ''
        }
    }

    // Coverage parameters
    coverage {
        cpu = 1
        forks = 1
        min_coverage = 1
        extra_args {
            depth = '-J'
        }
    }

    // Variant calling parameters
    calling {
        min_base_quality = 0
        min_snp_qual = 0

        bcftools {
            cpu = 4
            forks = 1
            extra_args {
                call = '--multiallelic-caller --variants-only'
                mpileup = '--count-orphans --max-depth 250'
            }
        }
        freebayes {
            cpu = 4
            forks = 1
            extra_args = '--use-best-n-alleles 4 --hwe-priors-off --no-population-priors --allele-balance-priors-off --haplotype-length -1 --throw-away-complex-obs --no-partial-observations --limit-coverage 250'
        }
        gatk {
            cpu = 4
            forks = 1
            extra_args = '--do-not-run-physical-phasing true --smith-waterman FASTEST_AVAILABLE --create-output-variant-index false --native-pair-hmm-threads 1'
        }
        vardict {
            cpu = 4
            forks = 1
            extra_args = '--nosv -k 0'
        }
        snver {
            cpu = 4
            forks = 1
            extra_args = '-p 0.01'
        }
    }

    consensus {
        cpu = 4
        forks = 1
    }

    
    output {
        type = 'single' // single - single file (all samples, all variant types), sample - separate file for each sample (all variant types)
        format = 'bcf' // output compressed VCF (vcf) or compressed BCF (bcf)
        variant_types = 'both' // snp - SNPs only, indel - INDELs only, both - SNPs and INDELs
        // multiallele_cons_type = 'full' // full - consensus of complete set of alternative alleles, partial - consensus of intersection of alternative alleles, ignore - ignore multiallelic sites
    }
}

// Reporting configuration
report {
    enabled     = true
    overwrite   = true
    file        = "${params.outdir}/pipeline_report.html"
}

// Timeline configuration
timeline {
    enabled     = true
    overwrite   = true
    file        = "${params.outdir}/timeline_report.html"
}

// Trace configuration
trace {
    enabled     = true
    overwrite   = true
    file        = "${params.outdir}/trace.txt"
}

// Manifest configuration
manifest {
    name            = 'ChoCallate'
    description     = 'Consensus variant calling pipeline'
    author          = 'A. Ermolaev'
    version         = '1.0.0'
    nextflowVersion = '>=25.0.0'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    homePage        = 'https://github.com/alermol/chocallate'
    license         = 'MIT'
}
